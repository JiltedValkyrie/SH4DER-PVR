+/* SH4DER-PVR: the AO demo's method 2 hook: Senior's ao_layer.h (the PVR map's AO) wired into the town's sink
+
+   demo/psm/psm_ao2.h
+   Copyright (c) 2026 Jilted Valkyrie. See ../../LICENSE.
+
+   psm_dc.c (PSM_AO_DEMO) includes this after psm_send.h. In route A's map pass, after the sun's casters (the opaque
+   list), with AO 2 on it opens the translucent list, calls psm_ao2_send (which ends the list in the sink), closes it.
+   The triangles go under the sink's kind PSM_HK_AO (4 words a vertex, translucent); psm_dc.c's send_hdr_ sends
+   psm_ao2_hdr[psm_ao2_unite] for it. The pages count the map pass's TA vertices and KB apart from the screen's.
+   Method 2 is ground only: route A's layer is the ground only, so it cannot darken walls. Uniform map only in v1. */
+
+#ifndef PSM_AO2_H
+#define PSM_AO2_H
+
+#define PSM_AO2_KIND PSM_HK_AO
+#ifndef PSM_AO2_K
+#define PSM_AO2_K 4u                        /* sky directions a frame: 0, 1, 2, 4 or 8 (ao_count) */
+#endif
+#include "ao_layer.h"
+
+/* 1 when psm_ao2_send has something to send this frame: the map is uniform (ao_layer.h does not clip) */
+static inline int psm_ao2_ready(void) { return state.warp == 0; }
+
+#endif /* PSM_AO2_H */
