diff --git a/ao1_src/demo/psm/tools/ao_bake.c b/ao1_src/demo/psm/tools/ao_bake.c
new file mode 100644
index 0000000..214ec5c
--- /dev/null
+++ b/ao1_src/demo/psm/tools/ao_bake.c
@@ -0,0 +1,163 @@
+/* SH4DER-PVR: the AO demo's baked ambient occlusion (method 1), a host tool run at build time
+
+   demo/psm/tools/ao_bake.c
+   Copyright (c) 2026 Jilted Valkyrie. See ../../../LICENSE.
+
+   cc -O2 -I<build>/psm_town demo/psm/tools/ao_bake.c -lm -o ao_bake && ./ao_bake <out.h>
+
+   Includes the baked town (psm_town_mesh.h, tools/bake_town.py --ao-demo) and writes psm_town_ao.h:
+   - psm_town_ao_v: a byte a static screen vertex, 255 open sky .. 0 closed, what the vertex's ambient light is multiplied by;
+   - psm_town_ao_g: the same on a grid over the ground (y 0), PSM_TOWN_AO_STEP metres a cell, read bilinear by the ground's
+     vertices at runtime (the ground is the ring lattice round the camera, not in the mesh).
+   Each point casts PSM_AO_RAYS cosine-weighted rays over its hemisphere (a fixed Hammersley set, so the output is the same on
+   every run), against the town's screen triangles within PSM_AO_R metres and the ground plane. A hit at distance t takes
+   1 - t / R of a ray. The movers (people, hens) are not in it: they move. Plain C, no SH4ZAM: it never runs on the console. */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "psm_town_mesh.h"
+
+#define PSM_AO_RAYS   64
+#define PSM_AO_R      2.5f        /* metres: the reach of the occlusion */
+#define PSM_AO_LIFT   0.01f       /* metres off the surface a ray starts */
+#define GRID_X0       (-40.0f)    /* the ground grid, world metres (x east, z south) */
+#define GRID_Z0       (-40.0f)
+#define GRID_STEP     0.5f
+#define GRID_N        161
+
+typedef struct { float a[3], e1[3], e2[3], lo[3], hi[3]; } tri_t;
+
+static tri_t tri[PSM_TOWN_T];
+static unsigned ntri, near_t[PSM_TOWN_T];
+static float dirs[PSM_AO_RAYS][3];
+
+static void sub3(const float *a, const float *b, float *o) { o[0] = a[0] - b[0]; o[1] = a[1] - b[1]; o[2] = a[2] - b[2]; }
+static void cross3(const float *a, const float *b, float *o) { o[0] = a[1] * b[2] - a[2] * b[1]; o[1] = a[2] * b[0] - a[0] * b[2]; o[2] = a[0] * b[1] - a[1] * b[0]; }
+static float dot3(const float *a, const float *b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+static void norm3(float *a) { const float l = sqrtf(dot3(a, a)); if (l > 1e-12f) { a[0] /= l; a[1] /= l; a[2] /= l; } }
+
+/* Moller-Trumbore, both faces; the hit distance or -1 */
+static float ray_tri(const float o[3], const float d[3], const tri_t *t) {
+    float h[3], s[3], q[3], det, inv, u, v, k;
+
+    cross3(d, t->e2, h);
+    det = dot3(t->e1, h);
+    if (fabsf(det) < 1e-9f) return -1.0f;
+    inv = 1.0f / det;
+    sub3(o, t->a, s);
+    u = dot3(s, h) * inv;
+    if (u < 0.0f || u > 1.0f) return -1.0f;
+    cross3(s, t->e1, q);
+    v = dot3(d, q) * inv;
+    if (v < 0.0f || u + v > 1.0f) return -1.0f;
+    k = dot3(t->e2, q) * inv;
+    return k > 1e-4f ? k : -1.0f;
+}
+
+/* the open share of p's hemisphere about unit n, 0 .. 1 */
+static float ao_at(const float p[3], const float n[3], int ground) {
+    float t0[3], t1[3], o[3], occl = 0.0f;
+    unsigned i, k, nn = 0;
+
+    for (i = 0; i < 3; i++) o[i] = p[i] + n[i] * PSM_AO_LIFT;
+    for (i = 0; i < ntri; i++) {                         /* the triangles whose box comes within R */
+        const tri_t *t = &tri[i];
+
+        if (o[0] < t->lo[0] - PSM_AO_R || o[0] > t->hi[0] + PSM_AO_R || o[1] < t->lo[1] - PSM_AO_R || o[1] > t->hi[1] + PSM_AO_R
+            || o[2] < t->lo[2] - PSM_AO_R || o[2] > t->hi[2] + PSM_AO_R) continue;
+        near_t[nn++] = i;
+    }
+    if (fabsf(n[1]) < 0.9f) { const float up[3] = { 0.0f, 1.0f, 0.0f }; cross3(up, n, t0); }
+    else { const float ex[3] = { 1.0f, 0.0f, 0.0f }; cross3(ex, n, t0); }
+    norm3(t0);
+    cross3(n, t0, t1);
+    for (k = 0; k < PSM_AO_RAYS; k++) {
+        float d[3], best = PSM_AO_R;
+
+        for (i = 0; i < 3; i++) d[i] = t0[i] * dirs[k][0] + n[i] * dirs[k][1] + t1[i] * dirs[k][2];
+        if (!ground && d[1] < -1e-6f && o[1] > 0.0f) {   /* the ground plane */
+            const float tg = -o[1] / d[1];
+
+            if (tg < best) best = tg;
+        }
+        for (i = 0; i < nn; i++) {
+            const float h = ray_tri(o, d, &tri[near_t[i]]);
+
+            if (h > 0.0f && h < best) best = h;
+        }
+        if (best < PSM_AO_R) occl += 1.0f - best / PSM_AO_R;
+    }
+    return 1.0f - occl / (float)PSM_AO_RAYS;
+}
+
+static unsigned char to_byte(float a) {
+    const float c = a < 0.0f ? 0.0f : a > 1.0f ? 1.0f : a;
+
+    return (unsigned char)(c * 255.0f + 0.5f);
+}
+
+int main(int argc, char **argv) {
+    static unsigned char av[PSM_TOWN_V], ag[GRID_N * GRID_N];
+    unsigned i, k, o, x, z, hist[5] = { 0 };
+    double sum = 0.0;
+    FILE *f;
+
+    if (argc < 2) { fprintf(stderr, "ao_bake <out.h>\n"); return 2; }
+    for (k = 0; k < PSM_AO_RAYS; k++) {                  /* cosine-weighted, Hammersley: u1 even steps, u2 the base-2 radical inverse */
+        unsigned b = k, r = 0;
+        float u1 = ((float)k + 0.5f) / (float)PSM_AO_RAYS, u2, rr, ph;
+
+        for (i = 0; i < 16; i++) { r = (r << 1) | (b & 1u); b >>= 1; }
+        u2 = (float)r / 65536.0f;
+        rr = sqrtf(u1); ph = 6.2831853f * u2;
+        dirs[k][0] = rr * cosf(ph); dirs[k][1] = sqrtf(1.0f - u1); dirs[k][2] = rr * sinf(ph);
+    }
+    for (k = 0, o = 0; k < PSM_TOWN_S; o += psm_town_sl[k], k++)
+        for (i = 0; i + 2u < psm_town_sl[k]; i++) {
+            const float *a = psm_town_v[psm_town_sv[o + i]], *b = psm_town_v[psm_town_sv[o + i + 1u]], *c = psm_town_v[psm_town_sv[o + i + 2u]];
+            tri_t *t = &tri[ntri];
+            unsigned j;
+
+            if (ntri >= PSM_TOWN_T) break;
+            memcpy(t->a, a, sizeof t->a);
+            sub3(b, a, t->e1); sub3(c, a, t->e2);
+            for (j = 0; j < 3; j++) {
+                t->lo[j] = fminf(a[j], fminf(b[j], c[j]));
+                t->hi[j] = fmaxf(a[j], fmaxf(b[j], c[j]));
+            }
+            ntri++;
+        }
+    for (i = 0; i < PSM_TOWN_V; i++) {
+        float n[3] = { (float)psm_town_n[i][0], (float)psm_town_n[i][1], (float)psm_town_n[i][2] };
+
+        norm3(n);
+        av[i] = to_byte(ao_at(psm_town_v[i], n, 0));
+        sum += av[i];
+        hist[av[i] * 5u / 256u]++;
+    }
+    for (z = 0; z < GRID_N; z++)
+        for (x = 0; x < GRID_N; x++) {
+            const float p[3] = { GRID_X0 + GRID_STEP * (float)x, 0.0f, GRID_Z0 + GRID_STEP * (float)z }, n[3] = { 0.0f, 1.0f, 0.0f };
+
+            ag[z * GRID_N + x] = to_byte(ao_at(p, n, 1));
+        }
+    f = fopen(argv[1], "w");
+    if (!f) { perror(argv[1]); return 1; }
+    fprintf(f, "/* Generated by demo/psm/tools/ao_bake.c from psm_town_mesh.h. Not in the repository: the build folder.\n"
+               "   %d rays a point, reach %.2f m; %u triangles; vertex mean %.1f of 255, by fifths %u %u %u %u %u. */\n",
+            PSM_AO_RAYS, (double)PSM_AO_R, ntri, sum / PSM_TOWN_V, hist[0], hist[1], hist[2], hist[3], hist[4]);
+    fprintf(f, "#if PSM_TOWN_V != %uu\n#error psm_town_ao.h was baked for another town mesh\n#endif\n", PSM_TOWN_V);
+    fprintf(f, "#define PSM_TOWN_AO_GN %d\n#define PSM_TOWN_AO_X0 (%.1ff)\n#define PSM_TOWN_AO_Z0 (%.1ff)\n#define PSM_TOWN_AO_STEP %.2ff\n",
+            GRID_N, (double)GRID_X0, (double)GRID_Z0, (double)GRID_STEP);
+    fprintf(f, "static const unsigned char psm_town_ao_v[PSM_TOWN_V] = {");
+    for (i = 0; i < PSM_TOWN_V; i++) fprintf(f, "%s%u,", i % 32u ? "" : "\n   ", av[i]);
+    fprintf(f, "\n};\nstatic const unsigned char psm_town_ao_g[PSM_TOWN_AO_GN * PSM_TOWN_AO_GN] = {");
+    for (i = 0; i < GRID_N * GRID_N; i++) fprintf(f, "%s%u,", i % 32u ? "" : "\n   ", ag[i]);
+    fprintf(f, "\n};\n");
+    fclose(f);
+    printf("ao_bake: %u vertices (mean %.1f), %d x %d ground cells, %u triangles\n", PSM_TOWN_V, sum / PSM_TOWN_V, GRID_N, GRID_N, ntri);
+    return 0;
+}
