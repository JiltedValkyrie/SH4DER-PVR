@@ -0,0 +1,65 @@
+/* Host check of demo/psm/psm_bake.h (prototype): route B at the town's boot state, every caster against the bake plus a
+   movers-only map. Prints the bake's counts (to set beside demo/psm/tools/town_bake.c), the host times, and how far the
+   two lit results are apart. Plain C path. Numbers are host ESTIMATEs. */
+#include <stdio.h>
+#include <time.h>
+#include "psm_scene.h"
+#include "psm_bake.h"
+
+static psm_scene_t scene;
+static psm_frame_t frame;
+static psm_bake_t bake;
+static uint16_t depth[256 * 256];
+static uint8_t g_all[PSM_GV_MAX], m_all[PSM_MV_MAX];
+
+static double now_ms(void) { return (double)clock() * 1000.0 / CLOCKS_PER_SEC; }
+
+static void route_b(const psm_state_t *st, int movers_only) {
+    if (!psm_frame_b_begin(&frame, &scene, depth)) { psm_frame_unshadowed(&frame, &scene); return; }
+    psm_frame_b_casters(&frame, &scene, movers_only);
+    psm_frame_b_receivers(&frame, &scene, st);
+}
+
+int main(void) {
+    psm_state_t st;
+    unsigned i, gdiff = 0, mdiff = 0, mdiff_static = 0, n_static_seen = 0;
+    double t, t_bake, t_all, t_mov, t_apply;
+    int fails = 0;
+
+    psm_scene_init(&scene);
+    psm_scene_init_town(&scene);
+    psm_state_town(&st);
+    st.route = PSM_ROUTE_B;
+    psm_town_update(&scene, &st, 0.0f);
+    psm_frame_setup(&frame, &scene, &st);
+    psm_place_geo(&frame, &scene);
+    printf("boot state: %02.0f:00-ish clock %.3f, sun az %.2f el %.2f, map %u, built %d, gvn %u, mvn %u (static %u)\n",
+           st.clock, st.clock, st.az, st.el, frame.size, frame.built, frame.gvn, scene.mvn, scene.mdyn0);
+
+    t = now_ms(); for (i = 0; i < 20u; i++) route_b(&st, 0); t_all = (now_ms() - t) / 20.0;
+    memcpy(g_all, frame.glit, frame.gvn); memcpy(m_all, frame.mlit, scene.mvn);
+
+    t = now_ms(); if (!psm_bake_run(&bake, &scene, frame.sun)) { printf("FAIL bake\n"); return 1; } t_bake = now_ms() - t;
+    printf("bake: %lu ray-triangle tests, static vertices shadowed %lu, ground texels shadowed %lu of %u (%.1f %%); host %.1f ms\n",
+           bake.tests, bake.shadowed_v, bake.shadowed_g, PSM_BAKE_SIDE * PSM_BAKE_SIDE, 100.0 * bake.shadowed_g / (PSM_BAKE_SIDE * PSM_BAKE_SIDE), t_bake);
+    fails += !psm_bake_valid(&bake, frame.sun);
+    fails += !psm_bake_movers_only(&bake, frame.sun, 0);
+
+    t = now_ms(); for (i = 0; i < 20u; i++) route_b(&st, 1); t_mov = (now_ms() - t) / 20.0;
+    t = now_ms(); psm_bake_apply(&bake, &frame, &scene); t_apply = now_ms() - t;
+    printf("route B on the host, a frame: every caster %.2f ms (%u tris); movers only %.2f ms (%u tris) + apply %.3f ms\n",
+           t_all, scene.ctn, t_mov, frame.tris, t_apply);
+
+    for (i = 0; i < frame.gvn; i++) gdiff += (unsigned)(g_all[i] > frame.glit[i] ? g_all[i] - frame.glit[i] : frame.glit[i] - g_all[i]) > 64u;
+    for (i = 0; i < scene.mvn; i++) {
+        const unsigned d = m_all[i] > frame.mlit[i] ? m_all[i] - frame.mlit[i] : frame.mlit[i] - m_all[i];
+
+        if (frame.vis_ok && !frame.mvis[i]) continue;
+        mdiff += d > 64u;
+        if (i < scene.mdyn0) { n_static_seen++; mdiff_static += d > 64u; }
+    }
+    printf("against every caster (a step of more than 64 of 255): ground %u of %u vertices (%.1f %%), model %u (static %u of %u sent, %.1f %%)\n",
+           gdiff, frame.gvn, 100.0 * gdiff / frame.gvn, mdiff, mdiff_static, n_static_seen, n_static_seen ? 100.0 * mdiff_static / n_static_seen : 0.0);
+    printf("%s\n", fails ? "FAILED" : "checks ok");
+    return fails != 0;
+}
