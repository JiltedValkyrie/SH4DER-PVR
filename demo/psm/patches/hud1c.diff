 static volatile unsigned boot_grace;
 static int boot_pvr;                        /* 1 once pvr_init is done */
 
+#ifdef HUD1C_VARIANT
+/* hud1c: hold A+B+X+Y or START for 3 s: back to the suite menu (or a reboot to the BIOS on a disc of its own). Read
+   from KallistiOS's controller state in the vertical blank. It needs interrupts: if they are dead it cannot run, and
+   that is itself the answer (a photo of the step line and no way out = interrupts off). */
+static unsigned esc_held, vbl_beat;
+
+static char *hud1c_u_(char *o, unsigned v) {   /* decimal, by hand: safe in the interrupt */
+    char t[12];
+    int n = 0;
+
+    do t[n++] = (char)('0' + v % 10u); while ((v /= 10u) && n < 11);
+    while (n) *o++ = t[--n];
+    return o;
+}
+
+static void hud1c_beat_line_(unsigned b) {   /* row 458: "VBL n  MAIN n  STEP n  F n  PAD xxxx" */
+    static const char hx[] = "0123456789ABCDEF";
+    char ln[80], *o = ln;
+    const char *k;
+    int i;
+
+    for (k = "VBL "; *k; ) *o++ = *k++;
+    o = hud1c_u_(o, vbl_beat);
+    for (k = "  MAIN "; *k; ) *o++ = *k++;
+    o = hud1c_u_(o, main_beat);
+    for (k = "  STEP "; *k; ) *o++ = *k++;
+    o = hud1c_u_(o, step_n);
+    for (k = "  F "; *k; ) *o++ = *k++;
+    o = hud1c_u_(o, frame_no);
+    for (k = "  PAD "; *k; ) *o++ = *k++;
+    for (i = 12; i >= 0; i -= 4) *o++ = hx[(b >> i) & 15u];
+    for (k = "  HELD "; *k; ) *o++ = *k++;
+    o = hud1c_u_(o, esc_held);
+    *o = 0;
+    if (vram_s) {
+        uint16_t *row = vram_s + 458u * 640u;
+        unsigned j;
+
+        for (j = 0; j < 640u * 16u; j++) row[j] = 0;
+        minifont_draw_str(row + 32u, 640u, ln);
+    }
+}
+static void hud1c_esc_vbl(uint32_t code, void *data) {
+    maple_device_t *dev;
+    cont_state_t *st;
+    unsigned b;
+
+    (void)code; (void)data;
+    dev = maple_enum_type(0, MAPLE_FUNC_CONTROLLER);
+    st = dev ? (cont_state_t *)maple_dev_status(dev) : NULL;
+    b = st ? st->buttons : 0u;
+    vbl_beat++;
+    if (!(vbl_beat & 7u)) hud1c_beat_line_(b);   /* every 8th blank: the vblank side is alive while this moves */
+    if ((b & SUITE_KEYS_ALL) == SUITE_KEYS_ALL || (b & CONT_START)) esc_held++;
+    else esc_held = 0;
+    if (esc_held < 180u) return;
+    irq_disable();
+    if (suite_present()) {
+        suite_menu_mail->chain = 0u;
+        suite_menu_mail->index = suite_mail.index;
+        suite_menu_mail->status = SUITE_KEYS;
+        arch_exec(suite_menu_image, (uint32_t)suite_menu_size);
+    }
+    arch_reboot();
+}
+#endif
+
 static void boot_vbl(uint32_t code, void *data) {
     (void)code; (void)data;
     if (boot_grace) { boot_grace--; fault_crumbs.beat++; }
