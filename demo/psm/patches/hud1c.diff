+static volatile unsigned step_n, main_beat;   /* main side: steps in frames 1-3, and frames ended */
+static void hud1c_step(const char *name) {
+    char ln[72];
+
+    if (frame_no > 3u) return;
+    step_n++;
+    main_beat++;
+    snprintf(ln, sizeof ln, "hud1c-%d F%u STEP %u %s   (stuck: hold ABXY/START 3 s)", HUD1C_VARIANT, frame_no, step_n, name);
+    printf("psm: %s\n", ln);
+    if (vram_s) {
+        uint16_t *row = vram_s + 440u * 640u;
+
+        memset(row, 0, 640u * 16u * sizeof *row);
+        minifont_draw_str(row + 32u, 640u, ln);
+    }
+}
+#define STEP(n) hud1c_step(n)
+#else
+#define STEP(n) ((void)0)
+#endif
