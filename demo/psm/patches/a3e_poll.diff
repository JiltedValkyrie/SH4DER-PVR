@@ -61,6 +61,82 @@
 #define PG_PREFIX "auto"
 #include "psm_page.h"
 #include "psm_auto.h"
+
+/* ---- the PVR's waits: each timed apart; PSM_POLL_WAIT polls them --------------------------------------------------
+   KallistiOS's pvr_wait_render_done sleeps and wakes up to 10 ms after the render is done (Q53, PVR-117). With
+   PSM_POLL_WAIT (off by default) the "ready" wait spins on pvr_check_ready, and the render-done wait spins until this
+   program's handler, put in front of KallistiOS's for the render-done event (KallistiOS's runs first, unchanged), has
+   counted as many renders as scenes were finished. Interrupts stay on: the spin only reads a counter the handler
+   writes. A wait longer than PSM_WAIT_LIMIT_US gives up, counts a timeout and resyncs the count. Without the switch the
+   same two functions call KallistiOS's waits, so the two images time the same waits the same way. */
+#define PSM_WAIT_LIMIT_US 100000u
+static uint64_t wait_us[2];               /* since boot: in the ready waits [0], in the render-done waits [1] */
+static unsigned long wait_n[2], wait_timeouts;
+#ifdef PSM_POLL_WAIT
+static asic_evt_handler_entry_t rd_prev;
+static volatile uint32_t rd_n;            /* render-done events seen */
+static uint32_t rd_want;                  /* scenes finished since the hook */
+static int rd_hooked;
+
+static void rd_evt(uint32_t code, void *data) {
+    (void)data;
+    if (rd_prev.hdl) rd_prev.hdl(code, rd_prev.data);
+    rd_n++;
+}
+
+static void rd_hook(int on) {
+    if (on && !rd_hooked) {
+        rd_n = 0u; rd_want = 0u;
+        rd_prev = asic_evt_set_handler(ASIC_EVT_PVR_RENDERDONE_TSP, rd_evt, NULL);
+        rd_hooked = rd_prev.hdl != NULL;
+        if (!rd_hooked) asic_evt_set_handler(ASIC_EVT_PVR_RENDERDONE_TSP, NULL, NULL);   /* none to chain: KallistiOS's waits */
+    } else if (!on && rd_hooked) {
+        asic_evt_set_handler(ASIC_EVT_PVR_RENDERDONE_TSP, rd_prev.hdl, rd_prev.data);
+        rd_hooked = 0;
+    }
+}
+#endif
+
+static int scene_finish_(void) {
+    const int r = pvr_scene_finish();
+#ifdef PSM_POLL_WAIT
+    rd_want++;
+#endif
+    return r;
+}
+
+static int wait_ready_(void) {
+    const uint64_t t0 = timer_us_gettime64();
+    int r;
+
+#ifdef PSM_POLL_WAIT
+    while ((r = pvr_check_ready()) < 0)
+        if (timer_us_gettime64() - t0 > PSM_WAIT_LIMIT_US) { wait_timeouts++; break; }
+#else
+    r = pvr_wait_ready();
+#endif
+    wait_us[0] += timer_us_gettime64() - t0; wait_n[0]++;
+    return r;
+}
+
+static int wait_done_(void) {
+    const uint64_t t0 = timer_us_gettime64();
+    int r = 0;
+
+#ifdef PSM_POLL_WAIT
+    if (rd_hooked) {
+        while ((int32_t)(rd_n - rd_want) < 0)
+            if (timer_us_gettime64() - t0 > PSM_WAIT_LIMIT_US) { wait_timeouts++; rd_want = rd_n; r = -1; break; }
+    } else r = pvr_wait_render_done();
+#else
+    r = pvr_wait_render_done();
+#endif
+    wait_us[1] += timer_us_gettime64() - t0; wait_n[1]++;
+    return r;
+}
+#define pvr_scene_finish() scene_finish_()
+#define pvr_wait_ready() wait_ready_()
+#define pvr_wait_render_done() wait_done_()
 #endif
 
