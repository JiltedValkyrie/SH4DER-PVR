+        pg_say("  parts %.1f %.1f %.1f %.1f  PVR %.1f/%.1f/%.1f  TAv %.0f/%.0f/%.0f",
+               psm_auto_mean(&t[PSM_AM_P0]), psm_auto_mean(&t[PSM_AM_P1]), psm_auto_mean(&t[PSM_AM_P2]), psm_auto_mean(&t[PSM_AM_P3]),
+               t[PSM_AM_PVR].lo, psm_auto_mean(&t[PSM_AM_PVR]), t[PSM_AM_PVR].hi,
+               t[PSM_AM_TAV].lo, psm_auto_mean(&t[PSM_AM_TAV]), t[PSM_AM_TAV].hi);
+        pg_say("  used KB %.0f/%.0f/%.0f  est KB %.0f/%.0f  KOS max %uK  SHED<=%u  text %uv",
+               t[PSM_AM_USED].lo, psm_auto_mean(&t[PSM_AM_USED]), t[PSM_AM_USED].hi, psm_auto_mean(&t[PSM_AM_EST]), t[PSM_AM_EST].hi,
+               (unsigned)(autos.used_max_kos[g] / 1024u), autos.shed_hi[g], autos.text_v[g]);
+        pg_say("  events %s %lu %s %lu %s %lu %s %lu %s %lu %s %lu%s",
