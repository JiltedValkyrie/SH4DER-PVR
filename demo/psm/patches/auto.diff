--- a/demo/psm/psm_auto.h
+++ b/demo/psm/psm_auto.h
@@ -0,0 +1,162 @@
+/* SH4DER-PVR: the town's autorun test: a fixed script and its numbers (demo/psm, PSM_AUTORUN images only)
+
+   demo/psm/psm_auto.h
+   Copyright (c) 2026 Jilted Valkyrie. See ../../LICENSE.
+
+   With PSM_AUTORUN, psm_dc.c boots the town into this script instead of the pad: the boot view (preset 0, the TOWN-001
+   view), 14:00, MAP 256 UNIFORM, CASTERS ALL, A FILTER bilinear, B FILTER 2 x 2, DIST INF, READOUT split, then a list of
+   segments, each a fixed number of frames: still, or a slow turn of 90 degrees right, on route A or B, at a time speed.
+   The simulation steps PSM_AUTO_DT a frame whatever the frame took, and every segment starts from the same pose, so the
+   camera, the sun and the walkers are the same in every image built with the same script. Then the program shows the
+   result pages (psm_page.h).
+
+   Each counted segment keeps min / mean / max of: the frame's time, the SH-4's four parts and their sum, the PVR's
+   render time (KallistiOS's last finished render, read every frame with no wait), the TA vertices, KallistiOS's vertex
+   buffer reading and this program's estimate; the TA's error events in the segment; for the bake image, the bakes and
+   their largest time. A frame strip (the largest frame time of each group of frames) is kept for the graph.
+
+   PSM_AUTO_HUD1 picks hud1's script: route A at the boot view in three states (normal, the text first, SHED 3 forced),
+   still then turning. Plain C, no KallistiOS: test/psm_auto_test.c runs the script and the statistics on the host. */
+
+#ifndef PSM_AUTO_H
+#define PSM_AUTO_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define PSM_AUTO_DT      (1.0f / 30.0f)   /* the simulation's step a frame, seconds */
+#define PSM_AUTO_TURN    1.5707963f        /* a turning segment's yaw, radians, over its frames */
+#define PSM_AUTO_STRIP   64u               /* points of the frame-time strip (psm_page.h's PG_POINTS) */
+#define PSM_AUTO_EVT_N   6u                /* the TA's error events: ISP, strip, PARAM, OPB, input error, input overflow */
+#define PSM_AUTO_METRICS 10u
+
+enum { PSM_AM_FRAME, PSM_AM_SH4, PSM_AM_P0, PSM_AM_P1, PSM_AM_P2, PSM_AM_P3, PSM_AM_PVR, PSM_AM_TAV, PSM_AM_USED, PSM_AM_EST };
+
+typedef struct psm_auto_seg {
+    const char *name;
+    unsigned frames;
+    int route;            /* PSM_ROUTE_A or PSM_ROUTE_B */
+    int turn;             /* 1: the yaw goes 0 .. PSM_AUTO_TURN over the segment */
+    unsigned tspeed;      /* TIME SPEED's index (psm_time_speed: 1 x1, 3 x60) */
+    int hud_first, s3;    /* hud1: the text first in the translucent list; SHED 3 forced */
+    int counted;          /* 0: a warm-up, not in the results */
+} psm_auto_seg_t;
+
+#ifdef PSM_AUTO_HUD1
+static const psm_auto_seg_t psm_auto_script[] = {
+    { "warm",       60u, PSM_ROUTE_A, 0, 1u, 0, 0, 0 },
+    { "A normal",  150u, PSM_ROUTE_A, 0, 1u, 0, 0, 1 },
+    { "A 1ST",     150u, PSM_ROUTE_A, 0, 1u, 1, 0, 1 },
+    { "A S3",      150u, PSM_ROUTE_A, 0, 1u, 0, 1, 1 },
+    { "A norm trn", 300u, PSM_ROUTE_A, 1, 1u, 0, 0, 1 },
+    { "A 1ST trn", 300u, PSM_ROUTE_A, 1, 1u, 1, 0, 1 },
+    { "A S3 trn",  300u, PSM_ROUTE_A, 1, 1u, 0, 1, 1 },
+};
+#else
+static const psm_auto_seg_t psm_auto_script[] = {
+    { "warm",      60u, PSM_ROUTE_A, 0, 1u, 0, 0, 0 },
+    { "A still",  150u, PSM_ROUTE_A, 0, 1u, 0, 0, 1 },
+    { "A turn",   300u, PSM_ROUTE_A, 1, 1u, 0, 0, 1 },
+    { "B still",  150u, PSM_ROUTE_B, 0, 1u, 0, 0, 1 },
+    { "B turn",   300u, PSM_ROUTE_B, 1, 1u, 0, 0, 1 },
+    { "B x60",    300u, PSM_ROUTE_B, 0, 3u, 0, 0, 1 },
+};
+#endif
+#define PSM_AUTO_SEGS (sizeof psm_auto_script / sizeof psm_auto_script[0])
+
+typedef struct psm_auto_stat {
+    unsigned n;
+    double sum;
+    float lo, hi;
+} psm_auto_stat_t;
+
+typedef struct psm_auto {
+    unsigned seg, frame;                     /* the segment, the frame in it */
+    unsigned total;                          /* counted frames so far */
+    int done;
+    float x0, z0, yaw0, pitch0;              /* the pose every segment starts from */
+    psm_auto_stat_t st[PSM_AUTO_SEGS][PSM_AUTO_METRICS];
+    uint32_t evt0[PSM_AUTO_EVT_N];           /* the event counts at the segment's start */
+    uint32_t evt[PSM_AUTO_SEGS][PSM_AUTO_EVT_N];
+    uint32_t used_max_kos[PSM_AUTO_SEGS];    /* KallistiOS's since-boot largest, at the segment's end */
+    unsigned shed_hi[PSM_AUTO_SEGS], text_v[PSM_AUTO_SEGS];
+    unsigned long bakes0, bakes[PSM_AUTO_SEGS];
+    uint32_t bake_us_hi[PSM_AUTO_SEGS];
+    float strip[PSM_AUTO_STRIP];             /* the largest frame ms of each group of counted frames */
+    unsigned strip_seg[PSM_AUTO_STRIP];      /* the segment each point's first frame was in */
+} psm_auto_t;
+
+static inline unsigned psm_auto_counted_frames(void) {
+    unsigned i, n = 0;
+
+    for (i = 0; i < PSM_AUTO_SEGS; i++) if (psm_auto_script[i].counted) n += psm_auto_script[i].frames;
+    return n;
+}
+
+static inline void psm_auto_stat_add(psm_auto_stat_t *s, float v) {
+    if (!s->n || v < s->lo) s->lo = v;
+    if (!s->n || v > s->hi) s->hi = v;
+    s->sum += v;
+    s->n++;
+}
+
+static inline float psm_auto_mean(const psm_auto_stat_t *s) { return s->n ? (float)(s->sum / (double)s->n) : 0.0f; }
+
+/* The pose and the switches of the frame about to be made. The caller then runs the town with dt = PSM_AUTO_DT. */
+static inline void psm_auto_apply(const psm_auto_t *a, psm_state_t *st, int *hud_first, int *s3) {
+    const psm_auto_seg_t *g = &psm_auto_script[a->seg < PSM_AUTO_SEGS ? a->seg : PSM_AUTO_SEGS - 1u];
+    const float t = g->turn && g->frames > 1u ? (float)a->frame / (float)(g->frames - 1u) : 0.0f;
+
+    st->route = g->route;
+    st->tspeed = g->tspeed;
+    st->x = a->x0; st->z = a->z0; st->pitch = a->pitch0;
+    st->yaw = a->yaw0 + PSM_AUTO_TURN * t;
+    st->menu = 0;
+    if (hud_first) *hud_first = g->hud_first;
+    if (s3) *s3 = g->s3;
+}
+
+/* The boot state of the script: the town's own boot state (preset 0, 14:00) with the readout split. */
+static inline void psm_auto_start(psm_auto_t *a, psm_state_t *st, const uint32_t evt[PSM_AUTO_EVT_N], unsigned long bakes) {
+    memset(a, 0, sizeof *a);
+    psm_state_town(st);
+    st->readout = 2; st->split = 1;
+    st->warp = 0; st->size_i = 2u; st->movers_only = 0; st->filter_a = 1; st->pcf = 1; st->dist_i = PSM_DIST_INF;
+    a->x0 = st->x; a->z0 = st->z; a->yaw0 = st->yaw; a->pitch0 = st->pitch;
+    memcpy(a->evt0, evt, sizeof a->evt0);
+    a->bakes0 = bakes;
+}
+
+/* One frame's numbers, after it was sent. v[] in PSM_AM_ order (ms, counts, bytes). Moves the script on; 1 when done. */
+static inline int psm_auto_frame(psm_auto_t *a, const float v[PSM_AUTO_METRICS], const uint32_t evt[PSM_AUTO_EVT_N],
+                                 uint32_t used_max_kos, unsigned shed, unsigned text_v, unsigned long bakes, uint32_t bake_us) {
+    const psm_auto_seg_t *g;
+    unsigned i;
+
+    if (a->done) return 1;
+    g = &psm_auto_script[a->seg];
+    if (g->counted) {
+        const unsigned per = (psm_auto_counted_frames() + PSM_AUTO_STRIP - 1u) / PSM_AUTO_STRIP, k = a->total / per;
+
+        for (i = 0; i < PSM_AUTO_METRICS; i++) psm_auto_stat_add(&a->st[a->seg][i], v[i]);
+        if (shed > a->shed_hi[a->seg]) a->shed_hi[a->seg] = shed;
+        a->text_v[a->seg] = text_v;
+        if (bakes != a->bakes0 && bake_us > a->bake_us_hi[a->seg]) a->bake_us_hi[a->seg] = bake_us;
+        if (k < PSM_AUTO_STRIP) {
+            if (a->total % per == 0u) { a->strip[k] = v[PSM_AM_FRAME]; a->strip_seg[k] = a->seg; }
+            else if (v[PSM_AM_FRAME] > a->strip[k]) a->strip[k] = v[PSM_AM_FRAME];
+        }
+        a->total++;
+    }
+    if (++a->frame < g->frames) return 0;
+    for (i = 0; i < PSM_AUTO_EVT_N; i++) a->evt[a->seg][i] = evt[i] - a->evt0[i];
+    memcpy(a->evt0, evt, sizeof a->evt0);
+    a->used_max_kos[a->seg] = used_max_kos;
+    a->bakes[a->seg] = bakes - a->bakes0;
+    a->bakes0 = bakes;
+    a->frame = 0;
+    if (++a->seg >= PSM_AUTO_SEGS) { a->seg = PSM_AUTO_SEGS - 1u; a->done = 1; }
+    return a->done;
+}
