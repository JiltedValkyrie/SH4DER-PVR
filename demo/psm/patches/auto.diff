+/* ---- the autorun test (psm_auto.h): the script in place of the pad, then the result pages --------------------------- */
+
+#ifndef PSM_AUTO_IMG
+#define PSM_AUTO_IMG 0
+#endif
+static const char *const auto_img_name[] = { "town-auto", "a3e-auto", "a3f-auto", "bake1-auto", "hud1-auto" };
+static psm_auto_t autos;
+static volatile uint32_t auto_evt[PSM_AUTO_EVT_N];
+static asic_evt_handler_entry_t auto_evt_prev[PSM_AUTO_EVT_N];
+static uint64_t auto_w0[4], auto_last_us;
+static uint32_t auto_vbuf_bytes;
+
+static void auto_evt_hnd(uint32_t code, void *data) {
+    const unsigned i = (unsigned)(code - ASIC_EVT_PVR_ISP_OUTOFMEM);
+
+    (void)data;
+    if (i < PSM_AUTO_EVT_N) {
+        auto_evt[i]++;
+        if (auto_evt_prev[i].hdl) auto_evt_prev[i].hdl(code, auto_evt_prev[i].data);
+    }
+}
+
+/* The TA's error events counted (KallistiOS hooks none in a normal build); the handler only counts, then chains */
+static void auto_hook(int on) {
+    unsigned i;
+
+    for (i = 0; i < PSM_AUTO_EVT_N; i++) {
+        const uint16_t code = (uint16_t)(ASIC_EVT_PVR_ISP_OUTOFMEM + i);
+
+        if (on) { auto_evt_prev[i] = asic_evt_set_handler(code, auto_evt_hnd, NULL); asic_evt_enable(code, ASIC_IRQ_DEFAULT); }
+        else asic_evt_set_handler(code, auto_evt_prev[i].hdl, auto_evt_prev[i].data);
+    }
+}
+
+static void auto_evt_now(uint32_t out[PSM_AUTO_EVT_N]) {
+    unsigned i;
+
+    for (i = 0; i < PSM_AUTO_EVT_N; i++) out[i] = auto_evt[i];
+}
+
+/* After the frame: its numbers into the script; 1 when the script is done */
+static int auto_record(const uint64_t win_us[4], uint32_t used, uint32_t used_max, uint32_t est, unsigned verts, unsigned shed,
+                       unsigned text_v, unsigned long bakes, uint32_t bake_us) {
+    const uint64_t now = timer_us_gettime64();
+    float v[PSM_AUTO_METRICS];
+    uint32_t evt[PSM_AUTO_EVT_N];
+    pvr_stats_t ps;
+    unsigned i;
+
+    v[PSM_AM_FRAME] = auto_last_us ? (float)(now - auto_last_us) * 1.0e-3f : 0.0f;
+    auto_last_us = now;
+    v[PSM_AM_SH4] = 0.0f;
+    for (i = 0; i < 4u; i++) { v[PSM_AM_P0 + i] = (float)(win_us[i] - auto_w0[i]) * 1.0e-3f; v[PSM_AM_SH4] += v[PSM_AM_P0 + i]; }
+    v[PSM_AM_PVR] = pvr_get_stats(&ps) == 0 ? (float)ps.rnd_last_time * 1.0e-6f : 0.0f;   /* the last finished render, no wait */
+    v[PSM_AM_TAV] = (float)verts;
+    v[PSM_AM_USED] = (float)used * (1.0f / 1024.0f);
+    v[PSM_AM_EST] = (float)est * (1.0f / 1024.0f);
+    auto_evt_now(evt);
+    return psm_auto_frame(&autos, v, evt, used_max, shed, text_v, bakes, bake_us);
+}
