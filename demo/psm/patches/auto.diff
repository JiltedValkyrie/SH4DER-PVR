+    p = pg_plot("mean per segment", "segment", "ms / %", 1);
+    for (g = 0; g < PSM_AUTO_SEGS; g++)
+        if (psm_auto_script[g].counted) { snprintf(nm, sizeof nm, "%.11s", psm_auto_script[g].name); pg_cat(p, nm); }
