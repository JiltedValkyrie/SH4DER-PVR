--- a/test/psm_auto_test.c
+++ b/test/psm_auto_test.c
@@ -0,0 +1,71 @@
+/* Host test of demo/psm/psm_auto.h: the script's frame counts, the same poses on two runs, the statistics, the strip,
+   the events and bakes by segment. Plain C path. */
+#include <stdio.h>
+#include <math.h>
+#include "psm_scene.h"
+#include "psm_auto.h"
+
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { fails++; printf("FAIL %s:%d ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static psm_auto_t a, b;
+
+/* runs the script; poses[] gets x, z, yaw, route, tspeed of every frame */
+static unsigned run(psm_auto_t *au, float (*poses)[5], unsigned max) {
+    psm_state_t st;
+    uint32_t evt[PSM_AUTO_EVT_N] = { 0 };
+    unsigned n = 0, bakes = 0;
+    int hf = 0, s3 = 0;
+
+    psm_auto_start(au, &st, evt, 0ul);
+    for (;;) {
+        float v[PSM_AUTO_METRICS];
+        unsigned i;
+
+        psm_auto_apply(au, &st, &hf, &s3);
+        if (n < max) { poses[n][0] = st.x; poses[n][1] = st.z; poses[n][2] = st.yaw; poses[n][3] = (float)st.route; poses[n][4] = (float)st.tspeed; }
+        for (i = 0; i < PSM_AUTO_METRICS; i++) v[i] = (float)(n % 7u) + (float)i;
+        if (au->seg == 2u && au->frame == 5u) evt[2] += 3u;          /* three PARAM events in segment 2 */
+        if (st.route == PSM_ROUTE_B && au->frame == 0u) bakes++;       /* a bake at each B segment's start */
+        n++;
+        if (psm_auto_frame(au, v, evt, 1024u * 1024u, 0u, 84u, bakes, 1000u + n)) break;
+        if (n > 100000u) { CHECK(0, "script never ends"); break; }
+    }
+    return n;
+}
+
+static float pa[4000][5], pb[4000][5];
+
+int main(void) {
+    unsigned na = run(&a, pa, 4000u), nb = run(&b, pb, 4000u), i, all = 0, g;
+
+    for (g = 0; g < PSM_AUTO_SEGS; g++) all += psm_auto_script[g].frames;
+    CHECK(na == all, "frames %u, script %u", na, all);
+    CHECK(na == nb, "two runs %u %u", na, nb);
+    CHECK(memcmp(pa, pb, sizeof pa) == 0, "the poses differ between runs");
+    CHECK(a.total == psm_auto_counted_frames(), "counted %u of %u", a.total, psm_auto_counted_frames());
+    for (g = 0; g < PSM_AUTO_SEGS; g++) {
+        const psm_auto_stat_t *t = &a.st[g][PSM_AM_FRAME];
+
+        if (!psm_auto_script[g].counted) { CHECK(t->n == 0u, "warm-up counted"); continue; }
+        CHECK(t->n == psm_auto_script[g].frames, "segment %u: %u of %u frames", g, t->n, psm_auto_script[g].frames);
+        CHECK(t->lo == 0.0f && t->hi == 6.0f, "segment %u: min %g max %g", g, t->lo, t->hi);
+        CHECK(a.evt[g][2] == (g == 2u ? 3u : 0u), "segment %u: PARAM %u", g, (unsigned)a.evt[g][2]);
+        CHECK(a.bakes[g] == (psm_auto_script[g].route == PSM_ROUTE_B ? 1u : 0u), "segment %u: bakes %lu", g, a.bakes[g]);
+    }
+    {   /* every segment starts at the boot pose; a turn ends PSM_AUTO_TURN to the right */
+        unsigned f = 0;
+
+        for (g = 0; g < PSM_AUTO_SEGS; g++) {
+            const unsigned last = f + psm_auto_script[g].frames - 1u;
+
+            CHECK(pa[f][0] == a.x0 && pa[f][1] == a.z0 && pa[f][2] == a.yaw0, "segment %u starts off the boot pose", g);
+            CHECK(fabsf(pa[last][2] - a.yaw0 - (psm_auto_script[g].turn ? PSM_AUTO_TURN : 0.0f)) < 1e-5f, "segment %u ends at yaw %g", g, pa[last][2]);
+            CHECK((int)pa[f][3] == psm_auto_script[g].route && (unsigned)pa[f][4] == psm_auto_script[g].tspeed, "segment %u: route or speed", g);
+            f = last + 1u;
+        }
+    }
+    for (i = 0; i < PSM_AUTO_STRIP; i++) CHECK(a.strip[i] >= 0.0f && a.strip[i] <= 6.0f, "strip %u = %g", i, a.strip[i]);
+    printf("psm_auto: %u segments, %u frames (%u counted), %u checks failed\n", (unsigned)PSM_AUTO_SEGS, na, a.total, fails);
+    return fails != 0;
+}
