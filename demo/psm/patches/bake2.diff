 static double now_ms(void) { return (double)clock() * 1000.0 / CLOCKS_PER_SEC; }
 
+/* bake1's test (Moller-Trumbore, one divide a test), the reference for the prepared form */
+static int ref_ray_tri(const float o[3], const float d[3], const float *a, const float *b, const float *c) {
+    const float e1[3] = { b[0] - a[0], b[1] - a[1], b[2] - a[2] }, e2[3] = { c[0] - a[0], c[1] - a[1], c[2] - a[2] };
+    float h[3], s[3], q[3], det, inv, u, v;
+
+    psm_bake_cross_(d, e2, h);
+    det = sh4der_dot3_(e1, h);
+    if (det > -1e-9f && det < 1e-9f) return 0;
+    inv = 1.0f / det;
+    s[0] = o[0] - a[0]; s[1] = o[1] - a[1]; s[2] = o[2] - a[2];
+    u = sh4der_dot3_(s, h) * inv;
+    if (u < 0.0f || u > 1.0f) return 0;
+    psm_bake_cross_(s, e1, q);
+    v = sh4der_dot3_(d, q) * inv;
+    if (v < 0.0f || u + v > 1.0f) return 0;
+    return sh4der_dot3_(e2, q) * inv > 1e-3f;
+}
+
+static unsigned long ref_tests;
+
+static int ref_sees(const psm_bake_t *b, const psm_scene_t *s, const float p[3]) {
+    unsigned k, j;
+
+    if (!psm_bake_bin_of_(b, p, &k)) return 1;
+    for (j = 0; j < b->binn[k]; j++) {
+        const unsigned t = b->bin[k][j];
+
+        ref_tests++;
+        if (ref_ray_tri(p, b->sun, s->cv[s->ct[t][0]], s->cv[s->ct[t][1]], s->cv[s->ct[t][2]])) return 0;
+    }
+    return 1;
+}
+
+/* bake1's bytes for the same bins: how many vertices and texels the prepared form changes */
+static void ref_compare(const psm_bake_t *b, const psm_scene_t *s) {
+    const float cell = PSM_BAKE_SPAN / (float)PSM_BAKE_SIDE;
+    unsigned i, j, dv = 0, dg = 0;
+    unsigned long sv = 0, sg = 0;
+
+    ref_tests = 0;
+    for (i = 0; i < s->mdyn0; i++) {
+        const float ndl = sh4der_dot3_(s->mn[i], b->sun);
+        float p[3];
+        unsigned byte;
+
+        if (!(ndl > 0.0f)) continue;
+        p[0] = s->mv[i][0] + s->mn[i][0] * PSM_BAKE_PUSH;
+        p[1] = s->mv[i][1] + s->mn[i][1] * PSM_BAKE_PUSH;
+        p[2] = s->mv[i][2] + s->mn[i][2] * PSM_BAKE_PUSH;
+        if (ref_sees(b, s, p)) byte = (unsigned)(sh4der_min1_(ndl) * 255.0f + 0.5f);
+        else { byte = 0u; sv++; }
+        dv += byte != b->vbake[i];
+    }
+    for (j = 0; j < PSM_BAKE_SIDE; j++)
+        for (i = 0; i < PSM_BAKE_SIDE; i++) {
+            const float p[3] = { PSM_BAKE_X0 + ((float)i + 0.5f) * cell, PSM_BAKE_GROUND_Y, PSM_BAKE_Z0 + ((float)j + 0.5f) * cell };
+            const unsigned lit = ref_sees(b, s, p) ? 255u : 0u;
+
+            sg += !lit;
+            dg += lit != b->gmap[j * PSM_BAKE_SIDE + i];
+        }
+    printf("bake1 reference (Moller-Trumbore, a divide a test): %lu tests, shadowed v %lu g %lu; prepared differs in %u vertices, %u texels\n",
+           ref_tests, sv, sg, dv, dg);
+}
