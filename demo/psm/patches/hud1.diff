+/* hud1: the boot menu, before pvr_init (the frame buffer, the 8 x 16 font, inside title-safe). A, X, Y or B picks; with no
+   button in 5 s (or no controller) it goes on as a3e: 1,024 KB and 4. */
+static void boot_menu(void) {
+    static const char *const ln[] = {
+        "SH4DER PSM TOWN hud1: vertex buffer test", "",
+        "A  buffer 1024 KB, bin pool x4   (as a3e)",
+        "X  buffer 1536 KB, bin pool x4",
+        "Y  buffer 1024 KB, bin pool x8",
+        "B  buffer 1536 KB, bin pool x8", "",
+        "In the town: hold L and R fully, then",
+        "  X  text first in the translucent list on/off",
+        "  Y  SHED 3 forced on/off",
+        "  A  reset the counters (and the FROZEN lines)",
+    };
+    const uint64_t t0 = timer_ms_gettime64();
+    unsigned i, pick = 0u, left = 99u;
+
+    for (;;) {
+        maple_device_t *dev = maple_enum_type(0, MAPLE_FUNC_CONTROLLER);
+        cont_state_t *st = dev ? (cont_state_t *)maple_dev_status(dev) : NULL;
+        const uint64_t ms = timer_ms_gettime64() - t0;
+        const unsigned s = ms >= 5000u ? 0u : (unsigned)((5000u - ms + 999u) / 1000u);
+        char line[64];
+
+        if (s != left) {
+            left = s;
+            memset(vram_s, 0, 640u * 480u * 2u);
+            for (i = 0; i < sizeof ln / sizeof ln[0]; i++) minifont_draw_str(vram_s + (64u + i * 20u) * 640u + 64u, 640u, ln[i]);
+            snprintf(line, sizeof line, "%u s, then A", s);
+            minifont_draw_str(vram_s + (64u + 12u * 20u) * 640u + 64u, 640u, line);
+        }
+        if (st && (st->buttons & (CONT_A | CONT_X | CONT_Y | CONT_B))) {
+            pick = (st->buttons & CONT_B) ? 3u : (st->buttons & CONT_Y) ? 2u : (st->buttons & CONT_X) ? 1u : 0u;
+            while (st->buttons & (CONT_A | CONT_X | CONT_Y | CONT_B)) {   /* let go first: the town must not see it */
+                thd_sleep(20);
+                dev = maple_enum_type(0, MAPLE_FUNC_CONTROLLER);
+                st = dev ? (cont_state_t *)maple_dev_status(dev) : NULL;
+                if (!st || timer_ms_gettime64() - t0 > 20000u) break;
+            }
+            break;
+        }
+        if (ms >= 5000u) break;
+        thd_sleep(20);
+    }
+    diag_vbuf = (pick & 1u) ? 1536u * 1024u : PSM_TA_VBUF;
+    diag_opb = (pick & 2u) ? 8u : PSM_OPB_EXTRA;
+    printf("psm: hud1 boot menu: buffer %u KB, bin pool x%u\n", (unsigned)(diag_vbuf / 1024u), diag_opb);
+}
