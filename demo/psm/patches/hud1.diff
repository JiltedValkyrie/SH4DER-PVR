+/* ---- hud1: the vertex buffer diagnostic (TOWN_NOTES "HUD lost at the start view") ------------------------------------
+   A box of four 8 x 16 lines in its own 512 x 64 texture, sent first in the opaque list (the one deliberate difference
+   from a3e's frame), at x 64 y 96 inside title-safe, from frame 0. Lines: KallistiOS's buffer reading and the estimate;
+   the TA's error events counted by our own ASIC handlers (KallistiOS hooks none in a normal build) and the switches; then
+   a frozen copy of both lines at the first parameter or bin overflow, kept until L+R+A. Switches: L+R held fully (the
+   town then sees no button, stick or trigger), X the text first in the translucent list, Y SHED 3 forced, A reset. The
+   buffer size and the bin pool are a boot menu (pvr_init cannot be redone without losing every texture). */
+#define DIAG_W 512u
+#define DIAG_H 64u
+#define DIAG_X 64.0f
+#define DIAG_Y 96.0f
+#define DIAG_LINES 4u
+#define DIAG_EVT_N 6u                     /* ASIC 0x0200 .. 0x0205: ISP, strip, PARAM, OPB, TA input error, TA input overflow */
+static uint16_t diag_px[DIAG_W * DIAG_H] __attribute__((aligned(32)));
+static pvr_ptr_t diag_mem;
+static pvr_poly_hdr_t hdr_diag;
+static char diag_ln[DIAG_LINES][PSM_HUD_COLS + 1u], diag_prev[DIAG_LINES][PSM_HUD_COLS + 1u];
+static volatile uint32_t diag_evt[DIAG_EVT_N];
+static asic_evt_handler_entry_t diag_evt_prev[DIAG_EVT_N];
+static uint32_t diag_evt_base[DIAG_EVT_N];  /* the counts at the last reset (L+R+A) or switch */
+static uint32_t diag_vbuf;                  /* the boot menu's choices (boot_menu sets both) */
+static unsigned diag_opb;
+static uint32_t diag_max_sw;                /* KallistiOS's last-frame reading, the largest since the last switch */
+static uint32_t est_op, est_tr;             /* this frame's estimate by list, from the live walk */
+static unsigned text_v;                     /* the readout's vertices this frame (text and its strips) */
+static int force_s3, hud_first, chord_prev, chord_kick;   /* hud_first goes into psm_send_hud_first_ each frame */
+static int frozen;                          /* 1: lines 2 and 3 hold the frame an overflow was first seen */
+static uint32_t ovf_seen;                   /* PARAM + OPB at the last frame looked at */
+
+static void diag_evt_hnd(uint32_t code, void *data) {
+    const unsigned i = (unsigned)(code - ASIC_EVT_PVR_ISP_OUTOFMEM);
+
+    (void)data;
+    if (i < DIAG_EVT_N) {
+        diag_evt[i]++;
+        if (diag_evt_prev[i].hdl) diag_evt_prev[i].hdl(code, diag_evt_prev[i].data);
+    }
+}
+
+static void diag_hook(void) {
+    unsigned i;
+
+    for (i = 0; i < DIAG_EVT_N; i++) {
+        diag_evt_prev[i] = asic_evt_set_handler((uint16_t)(ASIC_EVT_PVR_ISP_OUTOFMEM + i), diag_evt_hnd, NULL);
+        asic_evt_enable((uint16_t)(ASIC_EVT_PVR_ISP_OUTOFMEM + i), ASIC_IRQ_DEFAULT);
+    }
+}
+
+static uint32_t diag_since(unsigned i) { return diag_evt[i] - diag_evt_base[i]; }
+
+static void diag_reset(void) {
+    unsigned i;
+
+    for (i = 0; i < DIAG_EVT_N; i++) diag_evt_base[i] = diag_evt[i];
+    diag_max_sw = 0; frozen = 0;
+    ovf_seen = diag_evt[2] + diag_evt[3];
+}
+
+/* lines 0 and 1, live */
+static void diag_live(char l0[PSM_HUD_COLS + 1u], char l1[PSM_HUD_COLS + 1u]) {
+    const unsigned e = (unsigned)(diag_since(0) + diag_since(1) + diag_since(4));
+
+    snprintf(l0, PSM_HUD_COLS + 1u, "F%06u VB used%5uK/%uK sw%5uK boot%5uK est%5uK", frame_no % 1000000u,
+             (unsigned)(vbuf_used / 1024u), (unsigned)(diag_vbuf / 1024u), (unsigned)(diag_max_sw / 1024u),
+             (unsigned)(vbuf_max / 1024u), (unsigned)((est_op + est_tr) / 1024u));
+    snprintf(l1, PSM_HUD_COLS + 1u, "op%4uK tr%4uK txt%3uv SHED%u S3:%u 1ST:%u X%u P%u O%u I%u E%u%s",
+             (unsigned)(est_op / 1024u), (unsigned)(est_tr / 1024u), text_v, shed_now, force_s3, hud_first, diag_opb,
+             (unsigned)diag_since(2), (unsigned)diag_since(3), (unsigned)diag_since(5), e,
+             diag_since(2) + diag_since(3) + diag_since(5) ? " OVF" : "");
+}
+
+/* After the frame is sent: the largest reading since the switch, and the first overflow frozen into lines 2 and 3. */
+static void diag_frame(void) {
+    const uint32_t ovf = diag_evt[2] + diag_evt[3];
+
+    if (vbuf_used > diag_max_sw) diag_max_sw = vbuf_used;
+    if (ovf != ovf_seen && !frozen) {
+        char a[PSM_HUD_COLS + 1u], b[PSM_HUD_COLS + 1u];
+
+        diag_live(a, b);
+        snprintf(diag_ln[2], PSM_HUD_COLS + 1u, "FROZEN %.56s", a);
+        snprintf(diag_ln[3], PSM_HUD_COLS + 1u, "FROZEN %.56s", b);
+        frozen = 1;
+    }
+    ovf_seen = ovf;
+}
+
+/* The box's lines this refresh; 1 when they changed */
+static int diag_pending(void) {
+    diag_live(diag_ln[0], diag_ln[1]);
+    if (!frozen) {
+        snprintf(diag_ln[2], PSM_HUD_COLS + 1u, "no PARAM/OPB overflow since reset  (L+R: X 1ST, Y S3, A reset)");
+        diag_ln[3][0] = '\0';
+    }
+    return memcmp(diag_prev, diag_ln, sizeof diag_prev) != 0;
+}
+
+/* The changed lines into the box's texture (opaque list: black ground, white text). Call after the last render is done. */
+static void diag_upload(void) {
+    unsigned i, k;
+
+    for (i = 0; i < DIAG_LINES; i++) {
+        uint16_t *row = diag_px + i * 16u * DIAG_W;
+
+        if (!memcmp(diag_prev[i], diag_ln[i], sizeof diag_ln[i])) continue;
+        memset(row, 0, 16u * DIAG_W * sizeof *row);
+        minifont_draw_str(row, DIAG_W, diag_ln[i]);
+        for (k = 0; k < 16u * DIAG_W; k++) row[k] = row[k] ? 0xffffu : 0x8000u;    /* ARGB1555: white on black */
+        pvr_txr_load(row, (uint8_t *)diag_mem + i * 16u * DIAG_W * sizeof *row, 16u * DIAG_W * sizeof *row);
+    }
+    memcpy(diag_prev, diag_ln, sizeof diag_prev);
+}
