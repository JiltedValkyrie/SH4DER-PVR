+#ifdef PSM_BOOT_STAGES
+/* hud1b: the start, step by step (TOWN-107). Each step is a line in plain video memory (minifont into vram_s, no PVR,
+   so it shows before pvr_init too) and on the serial line, and the fault report's stage. The watchdog is armed from the
+   first step; a step that may take long gets a grace: the vertical blank beats for it, up to grace_s seconds, so a
+   hang there is reported grace_s + 2 s late instead of falsely at 2 s. */
+#define BOOT_ROWS 18u
+static char boot_ln[BOOT_ROWS][48];
+static unsigned boot_n;
+static volatile unsigned boot_grace;
+static int boot_pvr;                        /* 1 once pvr_init is done */
+
+static void boot_vbl(uint32_t code, void *data) {
+    (void)code; (void)data;
+    if (boot_grace) { boot_grace--; fault_crumbs.beat++; }
+}
+
+static void boot_stage(const char *name, unsigned grace_s) {
+    unsigned i;
+
+    psm_fault_stage(&fault_crumbs, name);
+    fault_crumbs.beat++;
+    boot_grace = grace_s * 60u;
+    printf("psm: boot %u %s\n", boot_n + 1u, name);
+    if (boot_n >= BOOT_ROWS) return;
+    snprintf(boot_ln[boot_n], sizeof boot_ln[0], "BOOT %2u  %s", boot_n + 1u, name);
+    boot_n++;
+    if (boot_pvr) {                          /* after pvr_init vram_s lies over buffer 0's vertex buffer: the new line only */
+        minifont_draw_str(vram_s + (72u + (boot_n - 1u) * 20u) * 640u + 64u, 640u, boot_ln[boot_n - 1u]);
+        return;
+    }
+    memset(vram_s, 0, 640u * 480u * 2u);     /* before pvr_init: the whole list again (the boot menu clears the screen) */
+    minifont_draw_str(vram_s + 40u * 640u + 64u, 640u, "SH4DER PSM TOWN hud1b: the start, step by step");
+    for (i = 0; i < boot_n; i++) minifont_draw_str(vram_s + (72u + i * 20u) * 640u + 64u, 640u, boot_ln[i]);
+}
+#define BOOT_STAGE(n, g) boot_stage((n), (g))
+#define BOOT_BEAT() (fault_crumbs.beat++)
+#else
+#define BOOT_STAGE(n, g) ((void)0)
+#define BOOT_BEAT() ((void)0)
+#endif
+
